# Copy to .env for local development. Never commit real credentials.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-long-password'))"
ADMIN_PASSWORD_HASH=
COOKIE_SECURE=false
DATABASE_PATH=attendance.db
KNOWN_FACES_DIR=known_faces
FACE_MATCH_TOLERANCE=0.48
EAR_THRESHOLD=0.21
LOG_LEVEL=INFO
